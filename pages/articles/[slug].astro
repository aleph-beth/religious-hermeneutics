---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const enArticles = await getCollection('en');
  return enArticles.map(article => ({
    params: { slug: article.data.pair },
    props: { pair: article.data.pair },
  }));
}

const { pair } = Astro.props;

const enArticles = await getCollection('en');
const frArticles = await getCollection('fr');

// Sort by order or pair
const sortedEnArticles = [...enArticles].sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const currentIndex = sortedEnArticles.findIndex(a => a.data.pair === pair);
const prevEn = currentIndex > 0 ? sortedEnArticles[currentIndex - 1] : null;
const nextEn = currentIndex < sortedEnArticles.length - 1 ? sortedEnArticles[currentIndex + 1] : null;

const prevFr = prevEn ? frArticles.find(a => a.data.pair === prevEn.data.pair) : null;
const nextFr = nextEn ? frArticles.find(a => a.data.pair === nextEn.data.pair) : null;

const enArticle = enArticles.find(a => a.data.pair === pair)!;
const frArticle = frArticles.find(a => a.data.pair === pair)!;

const { Content: EnContent, headings: enHeadings } = await render(enArticle);
const { Content: FrContent, headings: frHeadings } = await render(frArticle);

function getReadingTime(bodyText: string): number {
  if (!bodyText) return 5;
  const wordCount = bodyText.replace(/<[^>]*>/g, '').trim().split(/\s+/).length;
  return Math.max(2, Math.ceil(wordCount / 220));
}

const readingTimeEn = getReadingTime(enArticle.body || '');
const readingTimeFr = getReadingTime(frArticle.body || '');

const categoryBadges: Record<string, { labelEn: string; labelFr: string; badgeClass: string }> = {
  hermeneutics: { labelEn: 'Hermeneutics', labelFr: 'Herméneutique', badgeClass: 'badge-hermeneutics' },
  etymology: { labelEn: 'Etymology', labelFr: 'Étymologie', badgeClass: 'badge-etymology' },
  philosophy: { labelEn: 'Philosophy & History', labelFr: 'Philosophie & Histoire', badgeClass: 'badge-philosophy' },
  cultural: { labelEn: 'Cultural Analysis', labelFr: 'Analyse culturelle', badgeClass: 'badge-cultural' },
};

const catInfo = categoryBadges[enArticle.data.category] || { labelEn: 'Essay', labelFr: 'Essai', badgeClass: 'badge-hermeneutics' };
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<BaseLayout title={`${enArticle.data.title} – Midrash`} description={enArticle.data.description}>
  <div class="article-layout container-article">
    <!-- Top Reading Toolbar -->
    <nav class="reading-toolbar">
      <a href={base} class="back-home-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        <span data-lang="en" class="active">All essays</span>
        <span data-lang="fr">Tous les essais</span>
      </a>

      <div class="toolbar-actions">
        <!-- Reading Font Size Controls -->
        <div class="font-scaler">
          <button type="button" id="font-decrease" class="scale-btn" aria-label="Réduire la taille du texte">A-</button>
          <span id="font-scale-indicator" class="scale-indicator">100%</span>
          <button type="button" id="font-increase" class="scale-btn" aria-label="Agrandir la taille du texte">A+</button>
        </div>

        <!-- Share / Copy Link -->
        <button type="button" id="share-btn" class="share-btn" aria-label="Copier le lien">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
          <span id="share-text" data-lang="en" class="active">Copy link</span>
          <span id="share-text-fr" data-lang="fr">Copier le lien</span>
        </button>
      </div>
    </nav>

    <!-- Main Article Header -->
    <header class="article-header">
      <div class="header-meta-row">
        <span class={`badge ${catInfo.badgeClass}`}>
          <span data-lang="en" class="active">{catInfo.labelEn}</span>
          <span data-lang="fr">{catInfo.labelFr}</span>
        </span>

        {enArticle.data.dossier && (
          <span class="badge badge-dossier">
            <span data-lang="en" class="active">Dossier</span>
            <span data-lang="fr">Dossier</span>
          </span>
        )}

        <span class="meta-item">
          ⏱ <span data-lang="en" class="active">{readingTimeEn} min read</span>
          <span data-lang="fr">{readingTimeFr} min de lecture</span>
        </span>
      </div>

      <h1 class="article-title">
        <span data-lang="en" class="active">{enArticle.data.title}</span>
        <span data-lang="fr">{frArticle.data.title}</span>
      </h1>

      <p class="article-subtitle">
        <span data-lang="en" class="active">{enArticle.data.description}</span>
        <span data-lang="fr">{frArticle.data.description}</span>
      </p>
    </header>

    <!-- Article Content Grid with Table of Contents -->
    <div class="article-body-grid">
      <!-- Article Main Body -->
      <main class="article-main" id="article-main-body">
        <div data-lang="en" class="active article-content">
          <EnContent />
        </div>
        <div data-lang="fr" class="article-content">
          <FrContent />
        </div>
      </main>
    </div>

    <!-- Article Pagination Navigation Footer -->
    <footer class="article-footer-nav">
      <div class="pagination-grid">
        {prevEn ? (
          <a href={`${base}articles/${prevEn.data.pair}/`} class="pagination-card prev-card">
            <span class="pagination-label">
              ← <span data-lang="en" class="active">Previous essay</span>
              <span data-lang="fr">Essai précédent</span>
            </span>
            <span class="pagination-title">
              <span data-lang="en" class="active">{prevEn.data.title}</span>
              <span data-lang="fr">{prevFr?.data.title || prevEn.data.title}</span>
            </span>
          </a>
        ) : <div />}

        {nextEn ? (
          <a href={`${base}articles/${nextEn.data.pair}/`} class="pagination-card next-card">
            <span class="pagination-label">
              <span data-lang="en" class="active">Next essay</span>
              <span data-lang="fr">Essai suivant</span> →
            </span>
            <span class="pagination-title">
              <span data-lang="en" class="active">{nextEn.data.title}</span>
              <span data-lang="fr">{nextFr?.data.title || nextEn.data.title}</span>
            </span>
          </a>
        ) : <div />}
      </div>

      <div class="back-top-wrapper">
        <button type="button" id="back-top-btn" class="back-top-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
          <span data-lang="en" class="active">Back to top</span>
          <span data-lang="fr">Haut de page</span>
        </button>
      </div>
    </footer>
  </div>
</BaseLayout>

<script>
  function initArticlePage() {
    // Smooth scrolling for TOC and anchor links
    document.querySelectorAll('.article-content a[href^="#"]').forEach(link => {
      link.addEventListener('click', (e) => {
        const hash = link.getAttribute('href');
        if (!hash || hash === '#') return;
        const id = hash.slice(1);

        const activeContent = document.querySelector('.article-content.active');
        if (!activeContent) return;

        const target = activeContent.querySelector(`#${CSS.escape(id)}`);
        if (target) {
          e.preventDefault();
          const header = document.querySelector('.site-header');
          const offset = header ? header.getBoundingClientRect().height + 24 : 80;
          const top = target.getBoundingClientRect().top + window.scrollY - offset;
          window.scrollTo({ top, behavior: 'smooth' });
        }
      });
    });

    // Font Resizer Logic
    const root = document.documentElement;
    const fontDecrease = document.getElementById('font-decrease');
    const fontIncrease = document.getElementById('font-increase');
    const scaleIndicator = document.getElementById('font-scale-indicator');

    let currentScale = parseFloat(localStorage.getItem('midrash-font-scale') || '1.0');
    updateFontScale(currentScale);

    fontDecrease?.addEventListener('click', () => {
      if (currentScale > 0.85) {
        currentScale -= 0.1;
        updateFontScale(currentScale);
      }
    });

    fontIncrease?.addEventListener('click', () => {
      if (currentScale < 1.35) {
        currentScale += 0.1;
        updateFontScale(currentScale);
      }
    });

    function updateFontScale(scale: number) {
      currentScale = Math.round(scale * 10) / 10;
      localStorage.setItem('midrash-font-scale', currentScale.toString());
      if (scaleIndicator) scaleIndicator.textContent = `${Math.round(currentScale * 100)}%`;

      const contents = document.querySelectorAll('.article-content');
      contents.forEach(c => {
        (c as HTMLElement).style.fontSize = `${currentScale}rem`;
      });
    }

    // Share / Copy Link Button
    const shareBtn = document.getElementById('share-btn');
    shareBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const lang = document.documentElement.getAttribute('data-lang') || 'fr';
        const msg = lang === 'fr' ? 'Lien copié !' : 'Link copied!';
        const originalFr = document.getElementById('share-text-fr')?.textContent;
        const originalEn = document.getElementById('share-text')?.textContent;

        const frEl = document.getElementById('share-text-fr');
        const enEl = document.getElementById('share-text');

        if (frEl) frEl.textContent = 'Lien copié ✓';
        if (enEl) enEl.textContent = 'Copied ✓';

        setTimeout(() => {
          if (frEl && originalFr) frEl.textContent = originalFr;
          if (enEl && originalEn) enEl.textContent = originalEn;
        }, 2000);
      } catch (err) {
        console.error('Failed to copy', err);
      }
    });

    // Back to top button
    const backTopBtn = document.getElementById('back-top-btn');
    backTopBtn?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  document.addEventListener('astro:page-load', initArticlePage);
  initArticlePage();
</script>

<style>
  .article-layout {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-2xl);
  }

  /* Reading Toolbar */
  .reading-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--border-light);
  }

  .back-home-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-home-btn:hover {
    color: var(--accent);
  }

  .toolbar-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  /* Font Scaler */
  .font-scaler {
    display: inline-flex;
    align-items: center;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.15rem 0.35rem;
    font-size: 0.78rem;
  }

  .scale-btn {
    background: none;
    border: none;
    color: var(--text-secondary);
    font-weight: 600;
    cursor: pointer;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .scale-btn:hover {
    color: var(--text);
    background: var(--bg-muted);
  }

  .scale-indicator {
    padding: 0 0.35rem;
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 500;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.35rem 0.65rem;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .share-btn:hover {
    border-color: var(--text-secondary);
    color: var(--text);
  }

  /* Article Header */
  .article-header {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--border);
  }

  .header-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: var(--space-md);
  }

  .meta-item {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .article-title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.18;
    margin-bottom: var(--space-md);
    letter-spacing: -0.025em;
  }

  .article-subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    font-family: var(--font-heading);
    font-style: italic;
    line-height: 1.65;
    margin: 0;
  }

  /* Article Content */
  .article-content {
    line-height: 1.8;
    color: var(--text);
    transition: font-size 0.2s ease;
  }

  .article-content p {
    margin-bottom: var(--space-lg);
    font-size: 1.05rem;
  }

  .article-content h2 {
    font-size: 1.6rem;
    padding-top: var(--space-md);
    border-top: 1px solid var(--border-light);
  }

  .article-content h3 {
    font-size: 1.25rem;
  }

  /* Pagination Footer */
  .article-footer-nav {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border);
  }

  .pagination-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .pagination-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-lg);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: var(--shadow-sm);
  }

  .pagination-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .next-card {
    text-align: right;
  }

  .pagination-label {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: var(--space-2xs);
  }

  .pagination-title {
    font-family: var(--font-heading);
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.35;
  }

  .back-top-wrapper {
    display: flex;
    justify-content: center;
  }

  .back-top-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 9999px;
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .back-top-btn:hover {
    background: var(--bg-muted);
    color: var(--text);
  }

  @media (max-width: 640px) {
    .article-title {
      font-size: 1.85rem;
    }
    .pagination-grid {
      grid-template-columns: 1fr;
    }
    .next-card {
      text-align: left;
    }
  }
</style>
