---
import LangToggle from './LangToggle.astro';
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<div class="reading-progress-bar" id="reading-progress" aria-hidden="true"></div>

<header class="site-header" id="site-header">
  <div class="header-inner container">
    <div class="header-brand">
      <a href={base} class="site-logo">
        <span class="logo-mark">𐤀</span>
        <span class="logo-text">Midrash</span>
      </a>
      <span class="logo-subtitle">
        <span data-lang="en" class="active">Hermeneutics & Hermeneutic Studies</span>
        <span data-lang="fr">Études Herméneutiques</span>
      </span>
    </div>

    <nav class="header-nav">
      <a href={`${base}#hermeneutics`} class="nav-link">
        <span data-lang="en" class="active">Hermeneutics</span>
        <span data-lang="fr">Herméneutique</span>
      </a>
      <a href={`${base}#etymology`} class="nav-link">
        <span data-lang="en" class="active">Etymology</span>
        <span data-lang="fr">Étymologie</span>
      </a>
      <a href={`${base}#philosophy`} class="nav-link">
        <span data-lang="en" class="active">Philosophy</span>
        <span data-lang="fr">Philosophie</span>
      </a>
      <a href={`${base}#dossiers`} class="nav-link nav-highlight">
        <span data-lang="en" class="active">Dossiers</span>
        <span data-lang="fr">Dossiers</span>
      </a>
    </nav>

    <div class="header-controls">
      <LangToggle />
      <ThemeToggle />
    </div>
  </div>
</header>

<script>
  function handleScroll() {
    // Header shadow on scroll
    const header = document.getElementById('site-header');
    if (header) {
      if (window.scrollY > 20) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
    }

    // Reading progress calculation
    const progress = document.getElementById('reading-progress');
    if (progress) {
      const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
      if (totalHeight > 0) {
        const percent = Math.min(100, Math.max(0, (window.scrollY / totalHeight) * 100));
        progress.style.width = `${percent}%`;
      } else {
        progress.style.width = '0%';
      }
    }
  }

  window.addEventListener('scroll', handleScroll, { passive: true });
  document.addEventListener('astro:page-load', handleScroll);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    transition: background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .site-header.scrolled {
    box-shadow: var(--shadow-sm);
    background: var(--bg-surface);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    gap: var(--space-md);
  }

  .header-brand {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .site-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .logo-mark {
    font-family: serif;
    font-size: 1.3rem;
    color: var(--accent);
    line-height: 1;
  }

  .logo-text {
    background: linear-gradient(135deg, var(--text), var(--text-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .logo-subtitle {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
    letter-spacing: 0.02em;
    display: none;
  }

  @media (min-width: 860px) {
    .logo-subtitle {
      display: inline-block;
      padding-left: 0.6rem;
      border-left: 1px solid var(--border);
    }
  }

  .header-nav {
    display: none;
    align-items: center;
    gap: 1.25rem;
  }

  @media (min-width: 680px) {
    .header-nav {
      display: flex;
    }
  }

  .nav-link {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--accent);
  }

  .nav-highlight {
    font-weight: 600;
    color: var(--text);
  }

  .header-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
</style>
