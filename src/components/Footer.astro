    color: var(--text-muted);
    margin: 0;
  }

  .footer-license a {
    color: var(--text-secondary);
  }

  .footer-repo {
    font-size: 0.8rem;
    margin: var(--space-sm) 0 0;
  }

  .footer-repo a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: var(--text-muted);
    text-decoration: none;
  }

  .footer-repo a:hover {
    color: var(--text-secondary);
  }

  .footer-repo-icon {
    flex-shrink: 0;
  }
</style>
