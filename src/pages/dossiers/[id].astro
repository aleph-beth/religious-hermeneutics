---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { dossiers, categoryBadges, readingTime } from '../../data/dossiers';

export async function getStaticPaths() {
  return Object.keys(dossiers).map(id => ({ params: { id }, props: { id } }));
}

const { id } = Astro.props;
const meta = dossiers[id];

const enArticles = await getCollection('en');
const frArticles = await getCollection('fr');

const parts = enArticles
  .filter(a => a.data.dossier === id)
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
const frOf = (pair: string) => frArticles.find(f => f.data.pair === pair);

const category = parts[0] ? categoryBadges[parts[0].data.category] : null;
const totalMinutesEn = parts.reduce((sum, a) => sum + readingTime(a.body), 0);
const totalMinutesFr = parts.reduce((sum, a) => sum + readingTime(frOf(a.data.pair)?.body), 0);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<BaseLayout title={`${meta.titleEn} – Midrash`} description={meta.descEn}>
  <div class="dossier-page container-article">
    <nav class="dossier-toolbar">
      <a href={`${base}#dossiers`} class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        <span data-lang="en" class="active">All dossiers</span>
        <span data-lang="fr">Tous les dossiers</span>
      </a>
    </nav>

    <header class="dossier-header">
      <div class="meta-row">
        <span class="badge badge-dossier">
          <span data-lang="en" class="active">Dossier · {parts.length} parts</span>
          <span data-lang="fr">Dossier · {parts.length} volets</span>
        </span>
        {category && (
          <span class={`badge ${category.badgeClass}`}>
            <span data-lang="en" class="active">{category.labelEn}</span>
            <span data-lang="fr">{category.labelFr}</span>
          </span>
        )}
        <span class="meta-item">
          ⏱ <span data-lang="en" class="active">{totalMinutesEn} min in total</span>
          <span data-lang="fr">{totalMinutesFr} min au total</span>
        </span>
      </div>
      <h1 class="dossier-title">
        <span class="dossier-icon" aria-hidden="true">{meta.icon}</span>
        <span data-lang="en" class="active">{meta.titleEn}</span>
        <span data-lang="fr">{meta.titleFr}</span>
      </h1>
      <p class="dossier-desc">
        <span data-lang="en" class="active">{meta.descEn}</span>
        <span data-lang="fr">{meta.descFr}</span>
      </p>
    </header>

    <ol class="parts-list">
      {parts.map((a, i) => {
        const fr = frOf(a.data.pair);
        return (
          <li class="part-item">
            <a href={`${base}articles/${a.data.pair}/`} class="part-link">
              <span class="part-number">{i + 1}</span>
              <span class="part-body">
                <span class="part-title">
                  <span data-lang="en" class="active">{a.data.title}</span>
                  <span data-lang="fr">{fr?.data.title || a.data.title}</span>
                </span>
                <span class="part-desc">
                  <span data-lang="en" class="active">{a.data.description}</span>
                  <span data-lang="fr">{fr?.data.description || ''}</span>
                </span>
                <span class="part-meta">
                  ⏱ <span data-lang="en" class="active">{readingTime(a.body)} min read</span>
                  <span data-lang="fr">{readingTime(fr?.body)} min de lecture</span>
                </span>
              </span>
            </a>
          </li>
        );
      })}
    </ol>
  </div>
</BaseLayout>

<style>
  .dossier-page {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-2xl);
  }

  .dossier-toolbar {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--border-light);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
  }
  .back-link:hover { color: var(--accent); }

  .dossier-header {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--border);
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: var(--space-md);
  }

  .meta-item {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .dossier-title {
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-md);
  }

  .dossier-icon {
    margin-right: 0.5rem;
    font-size: 1.6rem;
    vertical-align: -0.1em;
  }

  .dossier-desc {
    font-size: 1.1rem;
    color: var(--text-secondary);
    font-family: var(--font-heading);
    font-style: italic;
    line-height: 1.65;
    margin: 0;
  }

  .parts-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-sm);
  }

  .part-link {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .part-link:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  .part-number {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text-muted);
    line-height: 1;
    padding-top: 0.1rem;
  }

  .part-body { display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; }

  .part-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .part-desc {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .part-meta {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .dossier-title { font-size: 1.7rem; }
    .part-link { grid-template-columns: 2rem 1fr; padding: var(--space-md); }
  }
</style>
