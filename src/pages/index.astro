---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { dossiers, categories, readingTime } from '../data/dossiers';

const enArticles = await getCollection('en');
const frArticles = await getCollection('fr');
const frOf = (pair: string) => frArticles.find(a => a.data.pair === pair);

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const totalArticlesCount = enArticles.length;

// Standalone essays per category, newest first
function standaloneFor(cat: string) {
  return enArticles
    .filter(a => a.data.category === cat && !a.data.dossier)
    .sort((a, b) => (b.data.date || '').localeCompare(a.data.date || ''));
}

// One card per dossier, with its parts in order
const dossierCards = Object.entries(dossiers).map(([id, meta]) => {
  const parts = enArticles
    .filter(a => a.data.dossier === id)
    .sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
  const category = categories.find(c => c.id === parts[0]?.data.category);
  const latest = parts.reduce((d, a) => ((a.data.date || '') > d ? a.data.date || '' : d), '');
  const searchable = [
    meta.titleEn, meta.titleFr, meta.descEn, meta.descFr,
    ...parts.flatMap(a => [a.data.title, a.data.description || '', frOf(a.data.pair)?.data.title || '', frOf(a.data.pair)?.data.description || '']),
  ].join(' ').toLowerCase();
  const minutesEn = parts.reduce((s, a) => s + readingTime(a.body), 0);
  const minutesFr = parts.reduce((s, a) => s + readingTime(frOf(a.data.pair)?.body), 0);
  return { id, meta, parts, category, latest, searchable, minutesEn, minutesFr };
}).sort((a, b) => b.latest.localeCompare(a.latest));
---

<BaseLayout title="Midrash – Herméneutique comparée & Philosophie">
  <section class="hero container">
    <div class="hero-content">
      <div class="hero-badge-pill">
        <span class="pulse-dot"></span>
        <span data-lang="en" class="active">{totalArticlesCount} essays · {dossierCards.length} dossiers · EN/FR</span>
        <span data-lang="fr">{totalArticlesCount} essais · {dossierCards.length} dossiers · FR/EN</span>
      </div>

      <h1 class="hero-title">
        <span data-lang="en" class="active">Hermeneutics, Myth & Semitic Reason</span>
        <span data-lang="fr">Herméneutique, Mythe & Raison Sémitique</span>
      </h1>

      <p class="hero-desc">
        <span data-lang="en" class="active">
          Comparative readings across Jewish, Christian, and Islamic traditions.
          Myth as mechanism, text as structure, hermeneutics as method.
        </span>
        <span data-lang="fr">
          Lectures comparées à travers les traditions juive, chrétienne et islamique.
          Le mythe comme mécanisme, le texte comme structure, l'herméneutique comme méthode.
        </span>
      </p>

      <div class="search-box-wrapper">
        <div class="search-input-group">
          <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <input
            type="text"
            id="article-search"
            class="search-input"
            placeholder="Rechercher un article, une racine, un concept (ex : Spinoza, Kafir, Médine…)"
            aria-label="Rechercher des articles"
          />
          <button type="button" id="search-clear" class="search-clear-btn" aria-label="Effacer" style="display:none;">✕</button>
        </div>

        <div class="filter-tabs" id="filter-tabs">
          <button type="button" class="filter-tab active" data-filter="all">
            <span data-lang="en" class="active">All</span>
            <span data-lang="fr">Tout</span>
          </button>
          <button type="button" class="filter-tab" data-filter="dossiers">
            <span data-lang="en" class="active">Dossiers</span>
            <span data-lang="fr">Dossiers</span>
          </button>
          {categories.map(cat => (
            <button type="button" class="filter-tab" data-filter={cat.id}>
              <span data-lang="en" class="active">{cat.titleEn}</span>
              <span data-lang="fr">{cat.titleFr}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="articles container" id="articles-section">
    <!-- Dossiers: one card each -->
    <div class="category-section" id="dossiers" data-category="dossiers">
      <div class="category-header">
        <div class="category-title-group">
          <span class="badge badge-dossier">
            <span data-lang="en" class="active">Dossiers</span>
            <span data-lang="fr">Dossiers</span>
          </span>
          <span class="category-count">{dossierCards.length}</span>
        </div>
        <p class="category-desc">
          <span data-lang="en" class="active">Multi-part investigations, to be read in order.</span>
          <span data-lang="fr">Enquêtes en plusieurs volets, à lire dans l'ordre.</span>
        </p>
      </div>

      <div class="card-grid">
        {dossierCards.map(d => (
          <article class="article-card dossier-card-item" data-searchable={d.searchable} data-category="dossiers">
            <a href={`${base}dossiers/${d.id}/`} class="card-inner">
              <div class="card-meta">
                <span class="badge badge-dossier">
                  <span data-lang="en" class="active">{d.parts.length} parts</span>
                  <span data-lang="fr">{d.parts.length} volets</span>
                </span>
                {d.category && (
                  <span class={`badge ${d.category.badgeClass}`}>
                    <span data-lang="en" class="active">{d.category.titleEn}</span>
                    <span data-lang="fr">{d.category.titleFr}</span>
                  </span>
                )}
                <span class="reading-time">
                  ⏱ <span data-lang="en" class="active">{d.minutesEn} min</span>
                  <span data-lang="fr">{d.minutesFr} min</span>
                </span>
              </div>

              <h3 class="card-title">
                <span class="card-icon" aria-hidden="true">{d.meta.icon}</span>
                <span data-lang="en" class="active">{d.meta.titleEn}</span>
                <span data-lang="fr">{d.meta.titleFr}</span>
              </h3>

              <p class="card-desc">
                <span data-lang="en" class="active">{d.meta.descEn}</span>
                <span data-lang="fr">{d.meta.descFr}</span>
              </p>

              <div class="card-footer">
                <span class="card-cta">
                  <span data-lang="en" class="active">Open the dossier</span>
                  <span data-lang="fr">Ouvrir le dossier</span>
                  <svg class="cta-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>

    <!-- Standalone essays by category -->
    {categories.map(cat => {
      const articles = standaloneFor(cat.id);
      if (articles.length === 0) return null;
      return (
        <div class="category-section" id={cat.id} data-category={cat.id}>
          <div class="category-header">
            <div class="category-title-group">
              <span class={`badge ${cat.badgeClass}`}>
                <span data-lang="en" class="active">{cat.titleEn}</span>
                <span data-lang="fr">{cat.titleFr}</span>
              </span>
              <span class="category-count">{articles.length}</span>
            </div>
            <p class="category-desc">
              <span data-lang="en" class="active">{cat.descEn}</span>
              <span data-lang="fr">{cat.descFr}</span>
            </p>
          </div>

          <div class="card-grid">
            {articles.map(article => {
              const fr = frOf(article.data.pair);
              const searchKeywords = `${article.data.title} ${fr?.data.title || ''} ${article.data.description || ''} ${fr?.data.description || ''}`.toLowerCase();
              return (
                <article class="article-card" data-searchable={searchKeywords} data-category={cat.id}>
                  <a href={`${base}articles/${article.data.pair}/`} class="card-inner">
                    <div class="card-meta">
                      <span class={`badge ${cat.badgeClass}`}>
                        <span data-lang="en" class="active">{cat.titleEn}</span>
                        <span data-lang="fr">{cat.titleFr}</span>
                      </span>
                      <span class="reading-time">
                        ⏱ <span data-lang="en" class="active">{readingTime(article.body)} min read</span>
                        <span data-lang="fr">{readingTime(fr?.body)} min de lecture</span>
                      </span>
                    </div>

                    <h3 class="card-title">
                      <span data-lang="en" class="active">{article.data.title}</span>
                      <span data-lang="fr">{fr?.data.title || article.data.title}</span>
                    </h3>

                    <p class="card-desc">
                      <span data-lang="en" class="active">{article.data.description}</span>
                      <span data-lang="fr">{fr?.data.description || ''}</span>
                    </p>

                    <div class="card-footer">
                      <span class="card-cta">
                        <span data-lang="en" class="active">Read the essay</span>
                        <span data-lang="fr">Lire l'essai</span>
                        <svg class="cta-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                      </span>
                    </div>
                  </a>
                </article>
              );
            })}
          </div>
        </div>
      );
    })}

    <div id="empty-search" class="empty-search-box" style="display:none;">
      <div class="empty-search-icon">🔍</div>
      <h3>
        <span data-lang="en" class="active">No essays found</span>
        <span data-lang="fr">Aucun essai trouvé</span>
      </h3>
      <p>
        <span data-lang="en" class="active">Try another search term or category filter.</span>
        <span data-lang="fr">Essayez un autre terme ou un autre filtre.</span>
      </p>
      <button type="button" id="reset-search-btn" class="reset-search-btn">
        <span data-lang="en" class="active">Reset search</span>
        <span data-lang="fr">Réinitialiser la recherche</span>
      </button>
    </div>
  </section>
</BaseLayout>

<script>
  function initSearchAndFilters() {
    const searchInput = document.getElementById('article-search') as HTMLInputElement | null;
    const clearBtn = document.getElementById('search-clear');
    const filterTabs = document.querySelectorAll('.filter-tab');
    const cards = document.querySelectorAll('.article-card');
    const sections = document.querySelectorAll('.category-section');
    const emptyState = document.getElementById('empty-search');
    const resetBtn = document.getElementById('reset-search-btn');

    let currentFilter = 'all';
    let searchQuery = '';

    function apply() {
      let visibleCount = 0;
      cards.forEach(card => {
        const el = card as HTMLElement;
        const searchable = el.getAttribute('data-searchable') || '';
        const cat = el.getAttribute('data-category') || '';
        const matchesQuery = !searchQuery || searchable.includes(searchQuery);
        const matchesFilter = currentFilter === 'all' || cat === currentFilter;
        const show = matchesQuery && matchesFilter;
        el.hidden = !show;
        if (show) visibleCount++;
      });
      sections.forEach(sec => {
        const el = sec as HTMLElement;
        el.hidden = el.querySelectorAll('.article-card:not([hidden])').length === 0;
      });
      if (emptyState) emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      if (clearBtn) clearBtn.style.display = searchQuery ? 'inline-flex' : 'none';
    }

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      apply();
    });

    clearBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      apply();
    });

    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      currentFilter = 'all';
      filterTabs.forEach(t => t.classList.remove('active'));
      document.querySelector('.filter-tab[data-filter="all"]')?.classList.add('active');
      apply();
    });

    filterTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        filterTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        currentFilter = tab.getAttribute('data-filter') || 'all';
        apply();
      });
    });
  }

  document.addEventListener('astro:page-load', initSearchAndFilters);
  initSearchAndFilters();
</script>

<style>
  .hero {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-xl);
  }

  .hero-content { max-width: 44rem; }

  .hero-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    background-color: var(--accent);
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .hero-title {
    font-size: 2.85rem;
    font-weight: 700;
    margin-bottom: var(--space-md);
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .hero-desc {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-xl);
    font-family: var(--font-heading);
    font-style: italic;
  }

  .search-box-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  .search-input-group {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    color: var(--text-muted);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: 0.85rem 2.8rem 0.85rem 2.8rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--text);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    transition: all 0.2s ease;
  }
  .search-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .search-clear-btn {
    position: absolute;
    right: 0.85rem;
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 0.9rem;
    padding: 0.25rem;
  }

  .filter-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-tab {
    padding: 0.4rem 0.9rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 9999px;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .filter-tab:hover { border-color: var(--text-secondary); color: var(--text); }
  .filter-tab.active {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }

  .articles { padding-bottom: var(--space-2xl); }

  .category-section { margin-bottom: var(--space-2xl); }

  .category-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--border);
  }

  .category-title-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .category-count {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .category-desc {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-lg);
  }

  .article-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .article-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--accent);
  }
  .dossier-card-item { border-left: 3px solid var(--cat-dossier-fg); }

  .card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-lg);
    text-decoration: none;
    color: inherit;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--space-md);
  }

  .reading-time {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
    margin-left: auto;
  }

  .card-title {
    font-size: 1.2rem;
    line-height: 1.3;
    margin-bottom: var(--space-sm);
  }
  .card-icon { margin-right: 0.4rem; }

  .card-desc {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-md);
    flex-grow: 1;
  }

  .card-footer { margin-top: auto; }

  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent);
  }
  .cta-arrow { transition: transform 0.2s ease; }
  .article-card:hover .cta-arrow { transform: translateX(3px); }

  .empty-search-box {
    text-align: center;
    padding: var(--space-2xl) var(--space-lg);
    color: var(--text-secondary);
  }
  .empty-search-icon { font-size: 2rem; margin-bottom: var(--space-md); }

  .reset-search-btn {
    margin-top: var(--space-md);
    padding: 0.5rem 1.1rem;
    background: var(--text);
    color: var(--bg);
    border: none;
    border-radius: 9999px;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }

  @media (max-width: 640px) {
    .hero-title { font-size: 2rem; }
    .card-grid { grid-template-columns: 1fr; }
  }
</style>
