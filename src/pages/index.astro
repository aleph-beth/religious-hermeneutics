---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const enArticles = await getCollection('en');
const frArticles = await getCollection('fr');

const categories = [
  {
    id: 'hermeneutics',
    titleEn: 'Hermeneutics',
    titleFr: 'Herméneutique',
  },
  {
    id: 'etymology',
    titleEn: 'Etymology',
    titleFr: 'Étymologie',
  },
  {
    id: 'philosophy',
    titleEn: 'Philosophy & History',
    titleFr: 'Philosophie & Histoire',
  },
  {
    id: 'cultural',
    titleEn: 'Cultural Analysis',
    titleFr: 'Analyse culturelle',
  },
];

function getArticlesForCategory(cat: string) {
  return enArticles
    .filter(a => a.data.category === cat)
    .sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
}

function getFrArticle(pair: string) {
  return frArticles.find(a => a.data.pair === pair);
}

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<BaseLayout>
  <section class="hero container">
    <h1 class="hero-title">Midrash</h1>
    <p class="hero-desc">
      <span data-lang="en" class="active">
        Comparative readings across Jewish, Christian, and Islamic traditions.
        Myth as mechanism, text as structure, hermeneutics as method.
      </span>
      <span data-lang="fr">
        Lectures comparées à travers les traditions juive, chrétienne et islamique.
        Le mythe comme mécanisme, le texte comme structure, l'herméneutique comme méthode.
      </span>
    </p>
  </section>

  <section class="articles container">
    {categories.map(cat => {
      const articles = getArticlesForCategory(cat.id);
      if (articles.length === 0) return null;
      return (
        <div class="category-section" id={cat.id}>
          <h2 class="category-title">
            <span data-lang="en" class="active">{cat.titleEn}</span>
            <span data-lang="fr">{cat.titleFr}</span>
          </h2>
          <div class="card-grid">
            {articles.map(article => {
              const fr = getFrArticle(article.data.pair);
              return (
                <a href={`${base}articles/${article.data.pair}/`} class="card">
                  <h3 class="card-title">
                    <span data-lang="en" class="active">{article.data.title}</span>
                    <span data-lang="fr">{fr?.data.title || article.data.title}</span>
                  </h3>
                  <p class="card-desc">
                    <span data-lang="en" class="active">{article.data.description}</span>
                    <span data-lang="fr">{fr?.data.description || ''}</span>
                  </p>
                  <span class="card-cta">
                    <span data-lang="en" class="active">Read →</span>
                    <span data-lang="fr">Lire →</span>
                  </span>
                </a>
              );
            })}
          </div>
        </div>
      );
    })}
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--border);
  }

  .hero-title {
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: var(--space-md);
    letter-spacing: -0.03em;
  }

  .hero-desc {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.8;
    max-width: 36rem;
    margin: 0;
  }

  .articles {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-2xl);
  }

  .category-section {
    margin-bottom: var(--space-2xl);
  }

  .category-title {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-top: 0;
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--border-light);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--space-md);
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: var(--space-md) var(--space-lg);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
    min-height: 9rem;
  }

  .card:hover {
    opacity: 1;
    border-color: var(--text);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
    margin: 0 0 var(--space-sm) 0;
    line-height: 1.3;
  }

  .card-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0 0 var(--space-md) 0;
    flex-grow: 1;
  }

  .card-cta {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: auto;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.25rem;
    }

    .hero {
      padding-top: var(--space-xl);
    }
  }
</style>
